generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           Int          @id @default(autoincrement())
  name         String
  legalName    String?
  email        String?
  phone        String?
  website      String?
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  logo         String?
  industry     String?
  timezone     String       @default("Africa/Lagos")
  currency     String       @default("NGN")
  workingDays  String?
  workingHours String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  language     String       @default("en")
  departments  Department[]
  roles        Role[]
  teams        Team[]
  users        User[]
  activities   Activity[]
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organizationId Int?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId Int?
  departmentId   String?
  employeeCount  Int           @default(0)
  location       String?
  manager        String?
  status         String        @default("Active")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  teams          Team[]
  users          User[]

  @@index([organizationId])
}

model Team {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  departmentId   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId Int?
  department     Department    @relation(fields: [departmentId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             Int           @id @default(autoincrement())
  employeeId     String        @unique
  name           String
  email          String        @unique
  phone          String?
  location       String?
  avatar         String?
  role           String
  status         String
  dateJoined     DateTime      @default(now())
  departmentId   Int?
  teamId         Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  emailVerified  Boolean       @default(false)
  isActive       Boolean       @default(true)
  lastLogin      DateTime?
  passwordHash   String?
  organizationId Int?
  attendances    Attendance[]
  department     Department?   @relation(fields: [departmentId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?         @relation(fields: [teamId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([departmentId])
}

model Attendance {
  id         Int       @id @default(autoincrement())
  userId     Int
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  workHours  Float?
  status     String
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Activity {
  id             String        @id @default(cuid())
  title          String
  description    String
  type           String
  createdAt      DateTime      @default(now())
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("activities")
}

model MarketplaceProduct {
  id          Int    @id @default(autoincrement())
  name        String
  slug        String @unique
  category    String
  description String
  imageUrl    String?

  // Base commercial price. All marketplace prices are managed in USD.
  priceUsd Decimal @default(0) @db.Decimal(12, 2)

  status    String   @default("DRAFT")
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries MarketplaceEnquiry[]
  payments  Payment[]

  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model CurrencySetting {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  symbol             String?
  decimalPlaces      Int      @default(2)
  enabled            Boolean  @default(true)
  fxProtectionMargin Decimal  @default(0) @db.Decimal(8, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  exchangeRates ExchangeRate[]

  @@index([enabled])
}

model ExchangeRate {
  id           Int       @id @default(autoincrement())
  currencyId   Int
  baseCurrency String    @default("USD")
  rate         Decimal   @db.Decimal(18, 8)
  source       String?
  fetchedAt    DateTime  @default(now())
  expiresAt    DateTime?
  isManual     Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  currency CurrencySetting @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@index([currencyId])
  @@index([baseCurrency])
  @@index([isActive])
  @@index([fetchedAt])
}

model Payment {
  id        Int    @id @default(autoincrement())
  reference String @unique
  provider  String @default("PAYSTACK")
  purpose   String
  status    String @default("PENDING")

  // Commercial source of truth.
  baseCurrency  String  @default("USD")
  baseAmountUsd Decimal @db.Decimal(12, 2)

  // What the customer was shown.
  displayCurrency String?
  displayAmount   Decimal? @db.Decimal(18, 2)

  // Final amount and currency locked for checkout.
  checkoutCurrency String
  checkoutAmount   Decimal @db.Decimal(18, 2)

  // FX snapshot used to calculate this payment.
  exchangeRate    Decimal? @db.Decimal(18, 8)
  fxMarginPercent Decimal? @db.Decimal(8, 4)

  accountId     Int?
  productId     Int?
  customerEmail String

  providerReference String? @unique
  providerData      Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account PublicAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  product MarketplaceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([provider])
  @@index([purpose])
  @@index([accountId])
  @@index([productId])
  @@index([customerEmail])
  @@index([createdAt])
}

model MarketplaceEnquiry {
  id           Int      @id @default(autoincrement())
  productId    Int?
  productName  String
  customerName String
  email        String
  phone        String
  country      String
  quantity     Int?
  message      String
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product MarketplaceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model Opportunity {
  id               Int       @id @default(autoincrement())
  title            String
  slug             String    @unique
  type             String
  organizationName String
  country          String
  location         String?
  description      String
  eligibility      String
  benefits         String?
  deadline         DateTime?

  // Application settings
  applicationMode String  @default("EXTERNAL")
  applicationUrl  String?

  sourceName         String?
  sourceUrl          String?
  verificationStatus String   @default("PUBLIC_LISTED")
  status             String   @default("DRAFT")
  featured           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applications OpportunityApplication[]

  @@index([type])
  @@index([country])
  @@index([verificationStatus])
  @@index([status])
  @@index([applicationMode])
  @@index([featured])
  @@index([deadline])
  @@index([createdAt])
}

model EducationProvider {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  type               String
  country            String
  city               String?
  description        String
  websiteUrl         String?
  logoUrl            String?
  verificationStatus String   @default("PUBLIC_LISTED")
  status             String   @default("DRAFT")
  featured           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  programs        EducationProgram[]
  trainingCourses TrainingCourse[]

  @@index([type])
  @@index([country])
  @@index([verificationStatus])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model EducationProgram {
  id                 Int       @id @default(autoincrement())
  providerId         Int
  name               String
  slug               String    @unique
  level              String
  fieldOfStudy       String
  description        String
  eligibility        String
  duration           String?
  studyMode          String?
  tuition            String?
  currency           String?
  applicationUrl     String?
  deadline           DateTime?
  intake             String?
  verificationStatus String    @default("PUBLIC_LISTED")
  status             String    @default("DRAFT")
  featured           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider EducationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([level])
  @@index([fieldOfStudy])
  @@index([verificationStatus])
  @@index([status])
  @@index([featured])
  @@index([deadline])
  @@index([createdAt])
}

model TrainingCourse {
  id                 Int       @id @default(autoincrement())
  providerId         Int
  name               String
  slug               String    @unique
  category           String
  description        String
  eligibility        String
  duration           String?
  deliveryMode       String?
  cost               String?
  currency           String?
  applicationUrl     String?
  deadline           DateTime?
  verificationStatus String    @default("PUBLIC_LISTED")
  status             String    @default("DRAFT")
  featured           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider EducationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([category])
  @@index([verificationStatus])
  @@index([status])
  @@index([featured])
  @@index([deadline])
  @@index([createdAt])
}

model Career {
  id                 Int       @id @default(autoincrement())
  title              String
  slug               String    @unique
  companyName        String
  country            String
  location           String?
  employmentType     String
  workMode           String?
  industry           String?
  description        String
  requirements       String
  responsibilities   String?
  benefits           String?
  salary             String?
  applicationUrl     String?
  deadline           DateTime?
  sourceName         String?
  sourceUrl          String?
  verificationStatus String    @default("PUBLIC_LISTED")
  status             String    @default("DRAFT")
  featured           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employmentType])
  @@index([country])
  @@index([industry])
  @@index([verificationStatus])
  @@index([status])
  @@index([featured])
  @@index([deadline])
  @@index([createdAt])
}

model Business {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  category           String
  country            String
  city               String?
  description        String
  services           String?
  websiteUrl         String?
  email              String?
  phone              String?
  logoUrl            String?
  verificationStatus String   @default("PUBLIC_LISTED")
  status             String   @default("DRAFT")
  featured           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([country])
  @@index([verificationStatus])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model PublicAccount {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  country                 String?
  city                    String?
  profileImage            String?
  status                  String                   @default("ACTIVE")
  emailVerified           Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  termsAccepted           Boolean                  @default(false)
  termsAcceptedAt         DateTime?
  termsVersion            String?
  sessions                PublicAccountSession[]
  activities              PublicAccountActivity[]
  opportunityApplications OpportunityApplication[]
  payments                Payment[]

  @@index([status])
  @@index([country])
  @@index([createdAt])
}

model PublicAccountSession {
  id        Int           @id @default(autoincrement())
  token     String        @unique
  accountId Int
  expiresAt DateTime
  createdAt DateTime      @default(now())
  account   PublicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model PublicAccountActivity {
  id          Int      @id @default(autoincrement())
  accountId   Int
  type        String
  module      String
  title       String
  description String?
  itemId      Int?
  itemSlug    String?
  itemUrl     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  account PublicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([type])
  @@index([module])
  @@index([createdAt])
}

model OpportunityApplication {
  id            Int @id @default(autoincrement())
  accountId     Int
  opportunityId Int

  firstName String
  lastName  String
  email     String
  phone     String?
  country   String?
  city      String?

  cvUrl       String?
  coverLetter String?
  message     String?

  status      String   @default("SUBMITTED")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     PublicAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunity Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([opportunityId])
  @@index([accountId, submittedAt])
  @@index([status])
  @@index([email])
}

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  subject String
  message String

  status String @default("UNREAD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}
